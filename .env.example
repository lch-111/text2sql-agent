# Text-to-SQL Agent 环境变量配置（示例）
# 云端 API 模式（OpenAI 兼容），无需本地 GPU

# ---- API 连接 ----
# 支持任意 OpenAI 兼容 API：阿里云 DashScope、DeepSeek、智谱、OpenAI 官方等
# model_client.py 按模型名前缀路由 Key 槽位：deepseek* → DEEPSEEK_API_KEY、
# qwen* → 百炼(OPENAI/DASHSCOPE)、glm* → GLM_API_KEY；某槽位为空自动沿
# DEEPSEEK → DASHSCOPE → OPENAI → GLM 回退到其它已配 Key。
# 注意：qwen 与 deepseek 均上架阿里云百炼，单把百炼 Key 即可调通全部角色模型。
DEEPSEEK_API_KEY=your-bailian-key-here   # deepseek-v4-pro-0813 走这里（百炼）
OPENAI_API_KEY=your-api-key-here         # qwen3.8-flash 走这里（百炼）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 管理令牌（SHA256 哈希值，留空仅允许本地访问管理接口）----
# 生成: echo -n 'your-token' | sha256sum
ADMIN_TOKEN=

# ---- 四个专用模型（可各自覆盖；qwen/deepseek 都在百炼，同一把百炼 Key 可调通）----
ROUTER_MODEL=qwen3.8-flash         # 分类/路由/工具选择用（百炼 qwen，轻量）
GENERATOR_MODEL=deepseek-v4-pro-0813 # SQL 生成用（百炼 deepseek，强推理）
CRITIC_MODEL=deepseek-v4-pro-0813  # 校验用（与生成同级别，保证纠错质量）
RERANKER_MODEL=qwen3.8-flash       # Schema 精排用（百炼 qwen，轻量）

# ---- 数据库配置（单数据源）----
DB_TYPE=mysql
# DB_TYPE=sqlite
# DB_TYPE=postgres

# MySQL 配置
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=my_db
MYSQL_USER=root
MYSQL_PASSWORD=123456

# SQLite 配置（DB_TYPE=sqlite 时使用）
DB_PATH=data/retail_warehouse.db

# PostgreSQL 配置（DB_TYPE=postgres 时使用）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=text2sql
PG_USER=text2sql
PG_PASSWORD=text2sql_secret

# ---- Redis 缓存 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_SIMILARITY_THRESHOLD=0.9
CACHE_TTL_SECONDS=3600

# ---- Agent 配置 ----
ENABLE_SQL_OPTIMIZER=true
MAX_RETRIES=2

# ---- 日志 ----
LOG_LEVEL=INFO
DEBUG=true
